<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WorkReview.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="28,12,28,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面头 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="PageTitle"
                Style="{StaticResource WaPageTitle}"
                VerticalAlignment="Center"
                OpticalMarginAlignment="TrimSideBearings" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <CalendarDatePicker
                    x:Name="DatePicker"
                    CornerRadius="4"
                    FirstDayOfWeek="Monday"
                    DateChanged="OnDateChanged" />
                <Button
                    x:Name="TodayButton"
                    Padding="10,6"
                    CornerRadius="4"
                    Click="OnTodayClicked" />
                <Button
                    x:Name="RefreshButton"
                    Padding="8,6"
                    CornerRadius="4"
                    Click="OnRefreshClicked"
                    AutomationProperties.Name="Refresh">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 错误横幅 -->
        <Border
            x:Name="ErrorBanner"
            Grid.Row="1"
            Padding="16,12"
            CornerRadius="8"
            Background="{StaticResource WaLayerBrush}"
            BorderBrush="{StaticResource WaDestructiveBrush}"
            BorderThickness="1"
            Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock x:Name="ErrorTitle" FontWeight="SemiBold" />
                    <TextBlock x:Name="ErrorText" Style="{StaticResource WaCaption}" />
                </StackPanel>
                <Button x:Name="RetryButton" Grid.Column="1" VerticalAlignment="Center" Click="OnRefreshClicked" />
            </Grid>
        </Border>

        <!-- 内容 -->
        <Grid Grid.Row="2">
            <!-- 加载中 -->
            <ProgressRing
                x:Name="LoadingRing"
                Width="44"
                Height="44"
                IsActive="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <!-- 空状态 -->
            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <FontIcon FontSize="34" Glyph="&#xE70B;" Foreground="{ThemeResource WaTextTertiaryBrush}" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource WaBody}" HorizontalAlignment="Center"
                           Foreground="{ThemeResource WaTextTertiaryBrush}" />
            </StackPanel>

            <!-- 列表卡片 -->
            <Border
                x:Name="ListCard"
                Style="{StaticResource WaLayerCard}"
                Padding="0"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 摘要条 -->
                    <Grid
                        Grid.Row="0"
                        Padding="16,10"
                        BorderBrush="{StaticResource WaStrokeBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock x:Name="RecordSummaryText" Style="{StaticResource WaBody}" TextTrimming="CharacterEllipsis" />
                            <Border
                                Background="{StaticResource WaLayerAltBrush}"
                                CornerRadius="4"
                                Padding="6,2"
                                VerticalAlignment="Center">
                                <TextBlock x:Name="HourBadgeText" Style="{StaticResource WaPillText}" />
                            </Border>
                        </StackPanel>
                        <Button
                            x:Name="SummaryLinkButton"
                            Grid.Column="1"
                            Padding="10,5"
                            CornerRadius="4"
                            Click="OnOpenSummaryClicked">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="13" Glyph="&#xE9D9;" />
                                <TextBlock x:Name="SummaryLinkText" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 活动信号轨 + 行列表 -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 签名活动信号轨：贯穿已采集会话的细色轨 -->
                        <Rectangle
                            Width="3"
                            Margin="16,8,0,8"
                            HorizontalAlignment="Left"
                            RadiusX="1.5"
                            RadiusY="1.5"
                            VerticalAlignment="Stretch">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#0060CDFF" />
                                    <GradientStop Offset="0.12" Color="#9060CDFF" />
                                    <GradientStop Offset="0.88" Color="#9060CDFF" />
                                    <GradientStop Offset="1" Color="#0060CDFF" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <ScrollViewer
                            x:Name="ListScroll"
                            Grid.Column="1"
                            Padding="10,6,6,8"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="RowsHost" Spacing="2" />
                        </ScrollViewer>
                    </Grid>

                    <!-- 加载更多 -->
                    <StackPanel Grid.Row="2" Padding="0,8">
                        <Button
                            x:Name="LoadMoreButton"
                            HorizontalAlignment="Center"
                            Padding="14,6"
                            CornerRadius="4"
                            Visibility="Collapsed"
                            Click="OnLoadMoreClicked" />
                        <TextBlock
                            x:Name="NoMoreText"
                            HorizontalAlignment="Center"
                            Style="{StaticResource WaCaption}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
