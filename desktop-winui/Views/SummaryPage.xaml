<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WorkReview.Views.SummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <Grid Padding="28,12,28,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 页面头 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock x:Name="PageTitle" Style="{StaticResource WaPageTitle}" />
                <TextBlock x:Name="PageDescription" Style="{StaticResource WaCaption}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <CalendarDatePicker
                    x:Name="DatePicker"
                    CornerRadius="4"
                    FirstDayOfWeek="Monday"
                    DateChanged="OnDateChanged" />
                <Button
                    x:Name="TodayButton"
                    Padding="10,6"
                    CornerRadius="4"
                    Click="OnTodayClicked" />
            </StackPanel>
        </Grid>

        <!-- 状态 -->
        <Border
            x:Name="ErrorBanner"
            Grid.Row="1"
            Padding="16,12"
            CornerRadius="8"
            Background="{StaticResource WaLayerBrush}"
            BorderBrush="{StaticResource WaDestructiveBrush}"
            BorderThickness="1"
            Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <ProgressRing
                x:Name="LoadingRing"
                Width="44"
                Height="44"
                IsActive="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />

            <StackPanel
                x:Name="EmptyState"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10"
                Visibility="Collapsed">
                <TextBlock Text="📊" FontSize="30" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource WaBody}"
                           Foreground="{ThemeResource WaTextTertiaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <ScrollViewer
                x:Name="ContentScroll"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel Spacing="14" MaxWidth="980" HorizontalAlignment="Stretch">
                    <!-- 意图分布 -->
                    <Border Style="{StaticResource WaLayerCard}">
                        <StackPanel Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock x:Name="IntentTitle" Style="{StaticResource WaSectionTitle}" FontSize="16" />
                                    <TextBlock x:Name="IntentDescription" Style="{StaticResource WaCaption}" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Background="{StaticResource WaLayerAltBrush}"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                    <TextBlock x:Name="IntentCount" Style="{StaticResource WaPillText}" />
                                </Border>
                            </Grid>
                            <StackPanel x:Name="IntentList" Spacing="10" />
                            <TextBlock
                                x:Name="IntentEmpty"
                                Style="{StaticResource WaCaption}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- 小时带 -->
                    <StackPanel x:Name="HourBands" Spacing="10" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
