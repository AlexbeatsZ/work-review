<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WorkReview.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:tb="using:H.NotifyIcon"
    Title="Work Review">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏（32px，跟随 Windows caption 几何） -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" Spacing="8">
                <Ellipse Width="14" Height="14" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="AppTitleIconBrush" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock
                    Text="Work Review"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource WaTextPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <muxc:NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="240"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="OnNavSelectionChanged">

            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem x:Name="NavTimeline" Content="时间线" Tag="timeline" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavSummary" Content="阶段汇总" Tag="summary">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem x:Name="NavSettings" Content="设置" Tag="settings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem IsEnabled="False" SelectsOnInvoked="False">
                    <muxc:NavigationViewItem.Content>
                        <Grid
                            Width="216"
                            Margin="12,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse
                                x:Name="RecordingDot"
                                Grid.Column="0"
                                Width="9"
                                Height="9"
                                Margin="4,0,8,0"
                                VerticalAlignment="Center"
                                Fill="{StaticResource WaSuccessBrush}" />
                            <TextBlock
                                x:Name="RecordingStatusText"
                                Grid.Column="1"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Style="{StaticResource WaNavStatusText}" />
                            <Button
                                x:Name="RecordingToggleButton"
                                Grid.Column="2"
                                Padding="6,2"
                                MinWidth="0"
                                MinHeight="0"
                                CornerRadius="4"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnRecordingToggle">
                                <FontIcon
                                    x:Name="RecordingToggleIcon"
                                    FontSize="14"
                                    Foreground="{ThemeResource WaTextSecondaryBrush}"
                                    Glyph="&#xE769;" />
                            </Button>
                        </Grid>
                    </muxc:NavigationViewItem.Content>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem IsEnabled="False" SelectsOnInvoked="False">
                    <muxc:NavigationViewItem.Content>
                        <Button
                            x:Name="LocaleButton"
                            Width="216"
                            Margin="12,0,0,8"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left"
                            Padding="12,6"
                            CornerRadius="4"
                            Background="Transparent"
                            BorderBrush="{StaticResource WaStrokeBrush}"
                            Click="OnLocaleCycle">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Foreground="{ThemeResource WaTextTertiaryBrush}" Glyph="&#xE8C1;" />
                                <TextBlock x:Name="LocaleButtonText" Style="{StaticResource WaNavStatusText}" />
                            </StackPanel>
                        </Button>
                    </muxc:NavigationViewItem.Content>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>

            <ContentControl
                x:Name="PageHost"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False" />
        </muxc:NavigationView>

        <!-- 顶部 Toast -->
        <Border
            x:Name="ToastLayer"
            Grid.Row="1"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            Margin="0,12,0,0"
            MaxWidth="560"
            Visibility="Collapsed">
            <muxc:InfoBar
                x:Name="ToastInfoBar"
                IsOpen="True"
                IsClosable="True"
                CornerRadius="8"
                Severity="Informational" />
        </Border>

        <!-- 托盘图标 -->
        <tb:TaskbarIcon
            x:Name="TrayIcon"
            ToolTipText="Work Review"
            Visibility="Collapsed" />
    </Grid>
</Window>
